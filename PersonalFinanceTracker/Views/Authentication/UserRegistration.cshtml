@model PersonalFinanceTracker.Models.Authentication.UserRegistration;


<div class="row justify-content-center">
    <div class="col-md-5 rounded-4 p-5 my-3 bg-light shadow-raised">
        <div class="row text-center p-2">
            <h4>Create Your Account!</h4>
        </div>
        <div asp-validation-summary="ModelOnly" class="w-50 mx-auto text-danger field-validation-error"></div>
        <form asp-action="Register" asp-controller="Authentication" method="post" data-val="true">
            <div class="row p-2">
                <div class="col-sm mb-4 mb-sm-0 field">
                    <input type="text" maxlength="100" asp-for="FirstName" class="form-control" placeholder=" " data-val="true" data-val-required="First Name is required!">
                    <label for="FirstName" class="input-label">* First Name</label>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-sm field">
                    <input type="text" maxlength="100" asp-for="LastName" class="form-control" placeholder=" " data-val="true" data-val-required="Last Name is required!">
                    <label for="LastName" class="input-label">* Last Name</label>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="row p-2">
                <div class="col-sm field">
                    <input type="text" maxlength="50" asp-for="UserName" class="form-control" placeholder=" " data-val="true" data-val-required="Username is required!">
                    <label for="UserName" class="input-label">* Username</label>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
            </div>
            <div class="row p-2">
                <div class="col-sm field">
                    <input type="text" maxlength="100" asp-for="Email" class="form-control" placeholder=" ">
                    <label for="Email" class="input-label">* Email</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="row p-2">
                <div class="col-sm">
                    <div class="password-container field">
                        <span id="togglePassword">👁️</span>
                        <input type="password" maxlength="100" asp-for="Password" class="form-control" placeholder=" " data-val="true">
                        <label for="Password" class="input-label">* Password</label>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>
            <div class="row p-2">
                <div class="col-sm">
                    <div class="password-container field">
                       <span id="toggleConfirmPassword">👁️</span>
                       <input type="password" maxlength="100" asp-for="ConfirmPassword" class="form-control" placeholder=" " data-val="true" data-val-required="Please confirm your password!">
                        <label for="ConfirmPassword" class="input-label">* Confirm Password</label>
                   </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="row p-2">
                <div class="col-sm">
                    <input type="checkbox" asp-for="AgreeToTermsAndPrivacyPolicy" class="form-check-input">
                    <label asp-for="AgreeToTermsAndPrivacyPolicy" class="form-check-label">
                        I agree to the Terms of Service and Privacy Policy
                    </label>
                    <span asp-validation-for="AgreeToTermsAndPrivacyPolicy" class="text-danger"></span>
                </div>

            </div>
            <div class="row p-2">
                <div class="col-sm">
                    <input type="submit" class="form-control btn btn-primary" id="registerUser" value="Sign Up" />
                </div>
            </div>

            <div class="row p-2">
                <div class="col-sm text-center">
                    <p>Already Registered? <a asp-area="" asp-controller="Authentication" asp-action="Login">Log in</a></p>
                </div>
            </div>
        </form>

    </div>
</div>

@section Scripts {

    @* AUTOMATIC VALIDATION ON CLIENT SIDE USING jQuery by asp.net mvc core framework!!! *@
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            const passwordInput = document.getElementById('Password');
            const togglePasswordBtn = document.getElementById('togglePassword');
            const confirmPasswordInput = document.getElementById('ConfirmPassword');
            const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPassword');

            togglePasswordBtn.addEventListener('click', function() {
                // Toggle the type attribute
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    this.textContent = '🙈'; // Changes to monkey emoji
                } else {
                    passwordInput.type = 'password';
                    this.textContent = '👁️'; // Changes back to eye emoji
                }
            });

            toggleConfirmPasswordBtn.addEventListener('click', function() {
                // Toggle the type attribute
                if (confirmPasswordInput.type === 'password') {
                    confirmPasswordInput.type = 'text';
                    this.textContent = '🙈'; // Changes to monkey emoji
                } else {
                    confirmPasswordInput.type = 'password';
                    this.textContent = '👁️'; // Changes back to eye emoji
                }
            });

            
            // Register the custom validation method globally first
            if ($.validator) {
                $.validator.addMethod("mustbetrue", function (value, element) {
                    return element.checked;
                }, "Please accept the terms and conditions!");
            }

            // Fetch the active form element
            var $form = $("form");

            // Ensure the unobtrusive validator settings are built and ready
            if ($form.data("validator")) {

                // SAFE TO ADD RULES NOW: Attach the rule safely to your checkbox
                $("#AgreeToTermsAndPrivacyPolicy").rules("add", {
                    mustbetrue: true
                });

                // Force all elements to validate immediately on blur/focusout
                $form.data("validator").settings.onfocusout = function (element) {
                    $(element).valid();
                };


                $form.data("validator").settings.onfocusout = function (element) {
                    // If this specific element uses remote validation, clear its cached memory
                    $(element).removeData("previousValue");
                    // Now safely trigger the fresh AJAX verification check
                    $(element).valid();
                };
            }
        });
    </script>

}

