@model IEnumerable<PersonalFinanceTracker.Models.Report>;

<div id="reportDataFilterDiv" class="filter-div">
    <h3>Reports <span id="reportInfo"
                       class="material-symbols-outlined-password"
                       data-bs-toggle="popover"
                       data-bs-trigger="hover"
                       data-bs-html="true"
                       data-bs-placement="bottom"
                       title="Reports"
                       data-bs-content="<ul>
                                            <li>Displays the &quot;Income &amp; Expense&quot;, &quot;Net Worth&quot;, &amp; &quot;Goal&quot; reports for the monthly and requested period between start &amp; end dates inclusive!</li>
                                        </ul>
                                        <hr>
                                        <ul>
                                            <li>Budget details for expense categories in &quot;Income &amp; Expense Reports&quot; would be -ve even though the entry in the budget screen has been +ve! When this entry has a +ve value in reports, means that the expenses has passed the budget limit for that category!</li>
                                            <li>Goal details will only display the transaction details of goal period for the requested time period for comparision. The transaction data for the requested period are excluded if they are out of goal period!</li>
                                        </ul>"
                       style="cursor:pointer;">
                        info
                     </span>
    </h3>
    <form id="reportDataFilterForm" data-val="true">
            @Html.AntiForgeryToken()
            <div class="row p-2">
                <div class="col-sm-2 mb-4 mb-sm-0 field">
                    <input type="date" id="reportStartDate" name="reportStartDate" class="form-control" placeholder=" " data-val="true" 
                    data-val-required="Start date is required!" data-val-lessThan="Start date must be earlier than end date!" data-val-lessThan-other="reportEndDate">
                    <label for="reportStartDate" class="input-label">* Start Date</label>
                    <span data-valmsg-for="reportStartDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>
                <div class="col-sm-2 field">
                    <input type="date" id="reportEndDate" name="reportEndDate" class="form-control" placeholder=" " data-val="true" data-val-required="End date is required!" >
                    <label for="reportEndDate" class="input-label">* End Date</label>
                    <span data-valmsg-for="reportEndDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>

                <div class="btn-group col-sm-3" role="group" aria-label="Basic radio toggle button group">
                  <input type="radio" class="btn-check" name="btnradio" id="btnRadioIncomeExpense" autocomplete="off" value="IncomeExpense" checked>
                  <label class="btn btn-outline-secondary" for="btnRadioIncomeExpense" style="width: 31% !important;">Income Expense Vs Budget</label>

                  <input type="radio" class="btn-check" name="btnradio" id="btnRadioNetWorth" value="NetWorth" autocomplete="off">
                  <label class="btn btn-outline-secondary" for="btnRadioNetWorth" style="width: 30% !important;">Net Worth</label>

                  <input type="radio" class="btn-check" name="btnradio" id="btnRadioGoal" value="Goal" autocomplete="off">
                  <label class="btn btn-outline-secondary" for="btnRadioGoal" style="width: 30% !important;">Goal</label>
                </div>

                <div class="btn-group col-sm-2" role="group" aria-label="Basic radio2 toggle button group">
                  <input type="radio" class="btn-check" name="btnradio2" id="btnRadioMonthly" autocomplete="off" value="1" checked>
                  <label class="btn btn-outline-secondary" for="btnRadioMonthly" style="width: 50% !important;">Monthly</label>

                  <input type="radio" class="btn-check" name="btnradio2" id="btnRadioWholePeriod" value="2" autocomplete="off">
                  <label class="btn btn-outline-secondary" for="btnRadioWholePeriod" style="width: 50% !important;">Whole Period</label>
                  
                </div>

                <div class="col-sm-2 field">
                    <div id="tagSelectContainer">
                        <select id="reportTagId" name="reportTagId"
                                class="form-control" placeholder=" ">
                        </select>
                        <label for="reportTagId" class="input-label">Filter By Tag</label>
                    </div>
                </div>
                <div class="col-sm-1 field">
                    <input type="submit" id="viewReport" name="viewReport" value="View Report" class="btn btn-primary">
                </div>
            </div>
    </form>
</div>

<div id="exportToExcelContainer" style="display:flex; align-items:center; justify-content:center; width:100%;">
    <h2 id="reportHeading"></h2>
    <h1>
        <span id="spanExportToExcel" title="Export To Excel">
            <span class="material-symbols-outlined-data-icon" style="margin-right:4px; font-size: 1em !important; color: dimgray !important;">file_save</span>
        </span>
    </h1>
</div>

<div class="table-container shadow-raised">
    <table class="table table-responsive bg-light" id="reportsTable">
        <thead id="reportsTHead">
                <!-- Contents will be added by javascript -->
        </thead>
        <tbody id="reportsTBody">
            <!-- Contents will be added by javascript -->
        </tbody>
    </table>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/gh/linways/table-to-excel@v1.0.4/dist/tableToExcel.js"></script>
    <script src="~/js/app/Report.js"></script>
    
}