@page
@using Syncfusion.EJ2
@{
    // ViewData["Title"] = "Home Page";
}

<div id="reportDataFilterDiv" class="filter-div">
    <h3>Dashboard</h3>
    <form id="reportDataFilterForm" data-val="true">
            @Html.AntiForgeryToken()
            <div class="row p-2">
                <div class="col-sm-2 mb-4 mb-sm-0 field">
                    <input type="date" id="reportStartDate" name="reportStartDate" class="form-control" placeholder=" " data-val="true" 
                    data-val-required="Start date is required!" data-val-lessThan="Start date must be earlier than end date!" data-val-lessThan-other="reportEndDate">
                    <label for="reportStartDate" class="input-label">* Start Date</label>
                    <span data-valmsg-for="reportStartDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>
                <div class="col-sm-2 field">
                    <input type="date" id="reportEndDate" name="reportEndDate" class="form-control" placeholder=" " data-val="true" data-val-required="End date is required!" >
                    <label for="reportEndDate" class="input-label">* End Date</label>
                    <span data-valmsg-for="reportEndDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>
                <div class="col-sm-2 field">
                    <input type="submit" id="refreshView" name="refreshView" value="Refresh View" class="btn btn-primary">
                </div>
            </div>
    </form>
</div>
<div class="container-fluid shadow-raised">
  <div class="row">
    <!-- Stack on mobile (100% width), 50% width on medium screens and up -->
    <div class="col-12 col-md-6 bg-primary text-white p-3 mt-3">
      First Div
    </div>
    <div class="col-12 col-md-6 bg-secondary text-white p-3 mt-3">
      Second Div
    </div>
    <div class="col-12 col-md-6 bg-primary text-white p-3 mt-3">
      Third Div
    </div>
    <div class="col-12 col-md-6 bg-secondary text-white p-3 mt-3">
      Fourth Div
    </div>
  </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Dashboard.js"></script>
    
}
