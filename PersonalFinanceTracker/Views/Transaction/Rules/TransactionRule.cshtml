@model IEnumerable<PersonalFinanceTracker.Models.TransactionRule>;

<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<div id="transactionRuleDataFilterDiv" class="filter-div">
    <h3>
        TransactionRule Rules <span id="transactionRuleInfo"
                               class="material-symbols-outlined-password"
                               data-bs-toggle="popover"
                               data-bs-trigger="hover"
                               data-bs-html="true"
                               data-bs-placement="bottom"
                               title="TransactionRule Rules"
                               data-bs-content="<ul>
                                                    <li><b>Rules run automatically in the background to auto-assign Categories and Goals!</b></li>
                                                    <li>Updates only auto-categorized or uncategorized transactions. Manual ones are untouched.</li>
                                                    <li>For Exact Amount: Negative (-) sign for outflows, positive/un-signed for inflows..</li>
                                                </ul>"
                               style="cursor:pointer;">
                            info
                         </span>

        <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span>
    </h3>
</div>

<table class="table bg-light shadow-raised" id="transactionRulesTable">
    <thead>
        <tr>
            <th colspan="3" style="background-color: rgba(128, 128,128, 0.05); border-right: 1px solid rgba(128, 128,128, 0.5);">Rule criteria:</th>
            <th colspan="5" style="background-color: rgba(128, 128,128, 0.05);">Change values to:</th>
        </tr>
        <tr>
            <th>Account</th>
            <th>Match Type</th>
            <th>Rule Text</th>
            <th>Category</th>
            <th>Goal</th>
            <th>New Description</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="transactionRulesTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditTransactionRuleModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditTransactionRuleModalLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditTransactionRuleModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditTransactionRuleForm" data-val="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalTransactionRuleId" name="transactionRuleId">
                    <div class="d-flex flex-wrap">
                        <div class="col-12 col-md-6 border border-1 rounded m-2 p-2">
                            <p class="p-1">
                                <b>When This Happens</b><br />
                                Match against transaction descriptions.<br />&nbsp;
                            </p>
                            <div class="row p-0">
                                <div class="col-sm field">
                                    <select id="modalAccountId" name="accountId"
                                            class="form-control" placeholder=" ">
                                    </select>
                                    <label for="modalAccountId" class="input-label">* Account</label>
                                    <span data-valmsg-for="accountId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                                </div>
                            </div>
                            <div class="row p-0">
                                <div class="col-sm field">
                                    <input type="text" maxlength="255" id="modalTransactionTextToMatch" name="transactionTextToMatch"
                                           class="form-control" placeholder=" " data-val="true"
                                           data-val-required="Please provide match text!" />
                                    <label for="modalTransactionTextToMatch" class="input-label">* Match Text</label>
                                    <span data-valmsg-for="transactionTextToMatch" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                                </div>
                            </div>

                            <div class="row p-0">
                                <div class="col-sm field">
                                    <select id="modalTransactionTextMatchComparision" name="transactionTextMatchComparision"
                                            class="form-control" placeholder=" ">
                                    </select>
                                    <label for="modalTransactionTextMatchComparision" class="input-label">Match Type</label>
                                </div>
                                <div class="col-sm field">
                                    <select id="modalTransactionAmountMatchComparision" name="transactionAmountMatchComparision"
                                            class="form-control" placeholder=" ">
                                    </select>
                                    <label for="modalTransactionAmountMatchComparision" class="input-label">Amount</label>
                                </div>
                            </div>
                            <div class="row p-0" id="exactTransactionAmountContainerDiv">
                                <div class="col-sm field">
                                    <div class="input-group">
                                        <div class="input-group-text" id="transactionCurrencySymbolId"></div>
                                        <input type="number" step="0.01" id="modalTransactionExactAmount" name="transactionExactAmount"
                                               class="form-control" placeholder=" " data-val="true"
                                               data-val-requiredif="Exact amount is required!"/>
                                        <label for="modalTransactionExactAmount" class="input-label">* Exact Amount</label>
                                    </div>
                                    <span data-valmsg-for="transactionExactAmount" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-5 border border-1 rounded m-2 p-2 ms-auto">
                            <p class="p-1">
                                <b>Then Do This</b><br />
                                Assign a category and optionally override the existing description & goal.
                            </p>
                            <div class="row p-0">
                                <div class="col-sm field">
                                    <select id="modalCategoryId" name="categoryId"
                                            class="form-control" placeholder=" " data-val="true"
                                            data-val-required="Please provide category!">
                                    </select>
                                    <label for="modalCategoryId" class="input-label">* Category</label>
                                    <span data-valmsg-for="categoryId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                                </div>
                            </div>
                            <div class="row p-0">
                                <div class="col-sm field">
                                    <select id="modalGoalId" name="goalId"
                                            class="form-control" placeholder=" ">
                                    </select>
                                    <label for="modalGoalId" class="input-label">Goal</label>
                                </div>
                            </div>
                            <div class="row p-0">
                                <div class="col-sm field">
                                    <input type="text" maxlength="255" id="modalTransactionDescriptionOverride" name="transactionDescriptionOverride"
                                           class="form-control" placeholder=" " title="Leave it blank to keep the original description"/>
                                    <label for="modalTransactionDescriptionOverride" class="input-label">Description Override</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="border border-1 rounded m-2 p-2">
                    <p>
                        <b>Preview</b>
                    </p>
                    <div class="description-div" id="trnRuleFunctionalDescription">

                    </div>
                    <div class="d-flex align-items-center pt-3">
                        <input type="checkbox" class="form-check-input toggle-switch" id="modalApplyRuleToExistingTransactions" name="applyRuleToExistingTransactions" value="0">
                        <label for="modalApplyRuleToExistingTransactions">&nbsp;&nbsp;Apply to existing transactions!</label>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnTransactionRuleModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/TransactionRule.js"></script>
}
