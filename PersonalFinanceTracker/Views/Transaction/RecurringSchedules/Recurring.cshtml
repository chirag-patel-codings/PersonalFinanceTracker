@model IEnumerable<PersonalFinanceTracker.Models.Recurring>;

<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<h3>
    Recurring Schedules <span id="recurringInfo"
                              class="material-symbols-outlined-password"
                              data-bs-toggle="popover"
                              data-bs-trigger="hover"
                              data-bs-html="true"
                              data-bs-placement="bottom"
                              title="Recurring Transactions"
                              data-bs-content="Recurring schuduled transactions will automatically move to the Transactions on the Due Date!
                                                <ul>
                                                    <li>For Amount: Use negative (-) sign for expenses, positive/un-signed for income.</li>
                                               </ul>"
                               style="cursor:pointer;">
                            info
                        </span>
    
    <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span>
    
</h3>

<table class="table bg-light shadow-raised" id="recurringsTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Account</th>
            <th>Frequency</th>
            <th>Next Due</th>
            <th>End Date</th>
            <th>Status</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="recurringsTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditRecurringModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditRecurringModalLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditRecurringModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditRecurringForm" data-val="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalRecurringId" name="recurringId">
                    <input type="hidden" id="modalTransactionCategorization" name="transactionCategorization">
                    <input type="hidden" id="modalTransactionRepeatId" name="transactionRepeatId">
                    <input type="hidden" id="modalCategoryType" name="categoryType" value="" />  <!-- To validate amount -->

                    <div class="row p-0">
                        <div class="d-flex align-items-center">
                            <input type="checkbox" class="form-check-input toggle-switch" id="modalIsTransactionRepeatActive" name="isTransactionRepeatActive" value="0">
                            <label for="modalIsTransactionRepeatActive">&nbsp;&nbsp;Schedule Active</label>
                            <a class="btn btn-outline-danger float-end ms-auto w-50" href="#" role="button" onclick="deleteRecurringSeries(event)" id="deleteRecurringSeries">Delete Recurring Series</a>
                        </div>
                        
                    </div>
                    <div class="row p-0">
                        <div class="col-sm field">
                            <select id="modalTransactionRepeatInterval" name="transactionRepeatInterval"
                                    class="form-control" placeholder=" " value="3">
                            </select>
                            <label for="modalTransactionRepeatInterval" class="input-label">Frequency</label>
                        </div>
                    </div>
                    <div class="row p-0">
                        <div class="col-sm col-md-6 field">
                            <input type="date" id="modalRecurringNextDate" name="recurringNextDate"
                                   class="form-control" placeholder=" " data-val="true" data-val-required="First Date is required!"
                                   data-val-dategte="First date must be today or later!"
                                   data-val-lessThan="First date must be earlier than end date!" data-val-lessThan-other="transactionRepeatEndDate">
                            <label for="modalRecurringNextDate" class="input-label">First Date</label>
                            <span data-valmsg-for="recurringNextDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                        <div class="col-sm col-md-6 field">
                            <input type="date" id="modalTransactionRepeatEndDate" name="transactionRepeatEndDate"
                                   class="form-control" placeholder=" ">
                            <label for="modalTransactionRepeatEndDate" class="input-label">End Date</label>
                        </div>

                    </div>
                    <div class="row p-0">
                        <div class="col-sm field">
                            <input type="text" maxlength="255" id="modalRecurringDescription" name="recurringDescription"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Please provide transaction name!" />
                            <label for="modalRecurringDescription" class="input-label">* Transaction Name</label>
                            <span data-valmsg-for="recurringDescription" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>

                    <div class="row p-0">
                        <div class="col-sm field">
                            <div class="input-group" title="Use negative (-) sign for expenses, positive/un-signed for income">
                                <div class="input-group-text" id="currencySymbolId"></div>
                                <input type="number" step="0.01" id="modalRecurringAmount" name="recurringAmount"
                                       class="form-control" placeholder=" " data-val="true"
                                       data-val-required="Please provide recurring amount!" 
                                       data-val-isvalidforcategorytype="For expense type of category, amount should be negative(-) otherwise positive(+)." data-val-isvalidforcategorytype-other="categoryType" />
                                <label for="modalRecurringAmount" class="input-label">* Recurring Amount</label>
                            </div>
                            <span data-valmsg-for="recurringAmount" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>

                    <div class="row p-0">
                        <div class="col-sm field">
                            <select id="modalAccountId" name="accountId"
                                    class="form-control" placeholder=" " data-val="true"
                                    data-val-required="Please provide account!">
                            </select>
                            <label for="modalAccountId" class="input-label">* Account</label>
                            <span data-valmsg-for="accountId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    
                    <div class="row p-0">
                        <div class="col-sm field">
                            <select id="modalCategoryId" name="categoryId"
                                    class="form-control" placeholder=" " data-val="true"
                                    data-val-required="Please provide category!">
                            </select>
                            <label for="modalCategoryId" class="input-label">* Category</label>
                            <span data-valmsg-for="categoryId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-0">
                        <div class="col-sm field">
                            <select id="modalGoalId" name="goalId"
                                    class="form-control" placeholder=" ">
                            </select>
                            <label for="modalGoalId" class="input-label">Goal</label>
                        </div>
                    </div>
                    <div class="row p-0">
                        <div class="col-sm field">
                            <select id="modalTagId" name="tagId"
                                    class="form-control" placeholder=" ">
                            </select>
                            <label for="modalTagId" class="input-label">Tag</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnRecurringModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Recurring.js"></script>
}
