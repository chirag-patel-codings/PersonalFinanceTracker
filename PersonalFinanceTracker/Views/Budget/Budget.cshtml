@model IEnumerable<PersonalFinanceTracker.Models.BudgetDetails>;

<!-- LINK ACCOUNT IS PENDING!!! -->
<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<div id="budgetDataFilterDiv" class="filter-div">
    <h3>Budgets 
        <span title='Hide Filter' class="material-symbols-outlined-data-icon float-end pe-2" style='font-size: 1em !important;' id="showHideBudgetFilters">call_made</span>
        <span title='Budget Rollover Settings' class='material-symbols-outlined-data-icon float-end pe-2' style='font-size: 1em !important;' id='showHideBudgetRolloverSettings' onclick='javascript: getBudgetSettings();'>settings</span>
     </h3>
    <form id="budgetDataFilterForm" data-val="true">
            @Html.AntiForgeryToken()
            <div class="row p-2">
                <div class="col-sm-3 mb-4 mb-sm-0 field">
                    <input type="date" id="budgetDetailsStartDate" name="budgetDetailsStartDate" class="form-control" placeholder=" " data-val="true" 
                    data-val-required="Start date is required!" data-val-lessThan="Start date must be earlier than end date!" data-val-lessThan-other="budgetDetailsEndDate">
                    <label for="budgetDetailsStartDate" class="input-label">* Start Date</label>
                    <span data-valmsg-for="budgetDetailsStartDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>
                <div class="col-sm-3 field">
                    <input type="date" id="budgetDetailsEndDate" name="budgetDetailsEndDate" class="form-control" placeholder=" " data-val="true" data-val-required="End date is required!" >
                    <label for="budgetDetailsEndDate" class="input-label">* End Date</label>
                    <span data-valmsg-for="budgetDetailsEndDate" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                </div>
            </div>
    </form>
</div>

<div class="table-container shadow-raised">
    <table class="table table-responsive bg-light" id="budgetsTable">
        <thead id="budgetsTHead">
            <tr id="budgetsTHeadRow">
                <!-- Contents will be added by javascript -->
            </tr>
        </thead>
        <tbody id="budgetsTBody">
            <!-- Contents will be added by javascript -->
        </tbody>
    </table>
</div>


<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditBudgetSettingsModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditBudgetSettingsModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditBudgetSettingsModalLabelId">Budget Settings</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="addEditBudgetSettingsModalBodyContainerId">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->

                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Budget.js"></script>

    
}
