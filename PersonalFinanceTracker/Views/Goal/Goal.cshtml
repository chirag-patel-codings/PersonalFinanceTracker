@model IEnumerable<PersonalFinanceTracker.Models.Goal>;

<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<h3>Goals <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span></h3>

<table class="table bg-light shadow-raised" id="goalsTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Type</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="goalsTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditGoalModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditGoalModalLabel">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditGoalModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditGoalFormId" name="addEditGoalFormName" data-val="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalGoalId" name="goalId">
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="100" id="modalGoalNameId" name="goalName"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Goal name is required!">
                            <label for="modalGoalNameId" class="input-label">* Goal Name</label>
                            <span data-valmsg-for="goalName" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="255" id="modalGoalDescriptionId" name="goalDescription" 
                                class="form-control" placeholder=" " />
                            <label for="modalGoalDescriptionId" class="input-label">Goal Description</label>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <select id="modalGoalTypeId" name="goalType"
                                    class="form-control" placeholder=" " data-val="true" data-val-required="Please provide the type of goal!">
                            </select>
                            <label for="modalGoalTypeId" class="input-label">* Goal Type</label>
                            <span data-valmsg-for="goalType" data-valmsg-replace="true"
                                  class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                </form>
                <!-- GOAL DETAILS SECTION!!! -->
                <div>
                    <h3 id="addGoalDetailsId" name="addGoalDetailsName" title='Add Details' class="float-end pe-2" onclick="appendGoalDetailForm(null);"><span class="material-symbols-outlined-data-icon">add</span></h3>
                </div>
                <div id="modalGoalDetailsContainerId" name="goalDetailsContainer" class="table-container" style="background-color: rgb(244, 246, 249);">

                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnGoalModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Goal.js"></script>
    
}
