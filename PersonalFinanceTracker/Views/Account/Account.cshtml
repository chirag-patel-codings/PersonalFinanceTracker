@model IEnumerable<PersonalFinanceTracker.Models.Account>;
<!-- LINK ACCOUNT IS PENDING!!! -->
<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<h3>Accounts <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span></h3>

<table class="table bg-light shadow-raised" id="accountsTable">
    <thead>
        <tr>
            <th>Account Name</th>
            <th>Institute Name</th>
            <th>Type</th>
            <th>Description</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="accountsTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditAccountModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditAccountModalLabel">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditAccountModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditAccountForm" data-val="true">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalAccountId" name="accountId">
                    <input type="hidden" id="modalIsALinkedAccountId" name="isALinkedAccount">
                    
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="100" id="modalAccountName" name="accountName"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Account name is required!">
                            <label for="modalAccountName" class="input-label">* Account Name</label>
                            <span data-valmsg-for="accountName" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="100" id="modalAccountInstitutionName" name="accountInstitutionName"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Account institution name is required!">
                            <label for="modalAccountInstitutionName" class="input-label">* Account Institution Name</label>
                            <span data-valmsg-for="accountInstitutionName" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <select id="modalAccountTypeId" name="accountTypeId"
                                    class="form-control" placeholder=" " data-val="true" data-val-required="Please provide the type of account!">
                            </select>
                            <label for="modalAccountTypeId" class="input-label">* Account Type</label>
                            <span data-valmsg-for="accountTypeId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="255" id="modalAccountDescription" name="accountDescription" class="form-control" placeholder=" " />
                            <label for="modalAccountDescription" class="input-label">Account Description</label>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnAccountModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Account.js"></script>
    
}
