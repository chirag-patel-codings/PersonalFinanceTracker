@model IEnumerable<PersonalFinanceTracker.Models.Category>;

<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<h3>Categories <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span></h3>

<table class="table bg-light shadow-raised" id="categoriesTable">
    <thead>
        <tr>
            <th>Color</th>
            <th>Name</th>
            <th>Type</th>
            <th>Description</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="categoriesTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditCategoryModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditCategoryModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditCategoryModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditCategoryForm" data-val="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalCategoryId" name="categoryId">
                    <input type="hidden" id="modalCategoryDisplayOrder" name="categoryDisplayOrder">
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="100" id="modalCategoryName" name="categoryName"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Category name is required!">
                            <label for="modalCategoryName" class="input-label">* Category Name</label>
                            <span data-valmsg-for="categoryName" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <select id="modalStandardizeCategory" name="standardCategoryId"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Please select standard category!">
                            </select>
                            <label for="modalStandardizeCategory" class="input-label">* Standardize Category</label>
                            <span data-valmsg-for="standardCategoryId" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <select id="modalCategoryType" name="categoryType"
                                    class="form-control" placeholder=" " data-val="true" data-val-required="Please provide the type of category!">
                            </select>
                            <label for="modalCategoryType" class="input-label">* Category Type</label>
                            <span data-valmsg-for="categoryType" data-valmsg-replace="true"
                                  class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="255" id="modalCategoryDescription" name="categoryDescription" class="form-control" placeholder=" " />
                            <label for="modalCategoryDescription" class="input-label">Category Description</label>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm-2 field">
                            <label for="modalCategoryColor" class="label-transparent">Category Color:</label>
                        </div>
                        <div class="col-sm field">
                            <input type="color" id="modalCategoryColor" name="categoryColor" class="form-control" placeholder=" " />
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnCategoryModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Category.js"></script>
    
}
