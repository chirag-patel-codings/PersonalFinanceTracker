@model IEnumerable<PersonalFinanceTracker.Models.Tag>;

<div id="dbMessage" class="alert" role="alert" style="display:none;"></div>
<h3>Tags <span title='Add' class="material-symbols-outlined-data-icon float-end pe-2">add</span></h3>

<table class="table bg-light shadow-raised" id="tagsTable">
    <thead>
        <tr>
            <th>Color</th>
            <th>Name</th>
            <th>Description</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody id="tagsTBody">
        <!-- Contents will be added by javascript -->
    </tbody>
</table>

<!-- REMOVED aria-hidden="true" from this line entirely -->
<div class="modal fade" id="addEditTagModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEditTagModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditTagModalLabelId"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- DESIGN: ALL THE FORM ELEMENTS MUST HAVE A NAME AND SAME AS DATA-MODEL'S NAME & CASE -->
                <form id="addEditTagForm" data-val="true">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalTagId" name="tagId">
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="100" id="modalTagName" name="tagName"
                                   class="form-control" placeholder=" " data-val="true"
                                   data-val-required="Tag name is required!">
                            <label for="modalTagName" class="input-label">* Tag Name</label>
                            <span data-valmsg-for="tagName" data-valmsg-replace="true" class="text-danger field-validation-valid"></span>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm field">
                            <input type="text" maxlength="255" id="modalTagDescription" name="tagDescription" class="form-control" placeholder=" " />
                            <label for="modalTagDescription" class="input-label">Tag Description</label>
                        </div>
                    </div>
                    <div class="row p-1">
                        <div class="col-sm-2 field">
                            <label for="modalTagColor" class="label-transparent">Tag Color:</label>
                        </div>
                        <div class="col-sm field">
                            <input type="color" id="modalTagColor" name="tagColor" class="form-control" placeholder=" " />
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnTagModalSaveChanges">
                    <span style="display:flex; align-items:center; justify-content:center; width:100%;">
                        <span class="material-symbols-outlined" style="margin-right:4px;">save</span>
                        Save
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/app/Tag.js"></script>
    
}
